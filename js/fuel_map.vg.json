{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 700,
  "height": 500,
  "title": "Average Petrol Price by State (c/L)",

  "data": {
  "url": "data/states.json",
  "format": {
    "type": "json",
    "property": "features"
  }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/fuel_prices_state.csv"
        },
        "key": "State",
        "fields": ["Price"]
      }
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white"
  },

  "encoding": {
    "color": {
      "field": "Price",
      "type": "quantitative",
      "scale": {
        "scheme": "reds"
      }
    },
    "tooltip": [
      { "field": "properties.STATE_NAME", "type": "nominal", "title": "State" },
      { "field": "Price", "type": "quantitative" }
    ]
  }
}