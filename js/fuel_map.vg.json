{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": 700,
  "height": 500,

  "title": "Average Petrol Price by State (cents per litre)",

  "data": {
    "url": "map/australian-states.json",
    "format": {
      "type": "json"
    }
  },

  "transform": [
  {
    "lookup": "properties.STATE_NAME",
    "from": {
        "data": {
            "url": "js/fuel_price_state.json"
        }
    }
  }
],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white"
  },

  "encoding": {
    "color": {
      "field": "Price",
      "type": "quantitative",
      "scale": {
        "scheme": "reds"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State"
      },
      {
        "field": "Price",
        "title": "Price (c/L)"
      }
    ]
  }
}