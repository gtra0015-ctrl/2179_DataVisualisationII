{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Fuel Prices Across Australian States — Ranked",
    "subtitle": "Sorted highest to lowest. NT stands alone 15% above the next highest state.",
    "subtitleColor": "#8a8f9e", "subtitleFontSize": 12,
    "fontSize": 14, "anchor": "start", "color": "#0f1117"
  },
  "width": 340,
  "height": 280,
  "data": {
    "url": "data/fuel_prices_state.csv",
    "format": { "type": "csv", "parse": { "Price": "number" } }
  },
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3 },
      "encoding": {
        "x": {
          "field": "State", "type": "nominal",
          "sort": { "field": "Price", "order": "descending" },
          "axis": {
            "labelAngle": 0,
            "title": "State / Territory",
            "labelFontSize": 11,
            "titleFontSize": 11,
            "titlePadding": 8
          }
        },
        "y": {
          "field": "Price", "type": "quantitative",
          "title": "Fuel Price (c/L)",
          "scale": { "zero": false, "domain": [175, 216] },
          "axis": { "labelFontSize": 10, "titleFontSize": 11 }
        },
        "color": {
          "field": "Price", "type": "quantitative",
          "scale": { "scheme": "reds", "domain": [178, 215] },
          "legend": null
        },
        "tooltip": [
          { "field": "State", "title": "State" },
          { "field": "Price", "title": "Price (c/L)", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#8a8f9e", "strokeDash": [4, 3], "strokeWidth": 1.5 },
      "encoding": {
        "y": { "aggregate": "mean", "field": "Price", "type": "quantitative" }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": 165,
        "dy": -4,
        "fontSize": 10,
        "color": "#8a8f9e",
        "fontStyle": "italic"
      },
      "encoding": {
        "y": { "aggregate": "mean", "field": "Price", "type": "quantitative" },
        "text": { "value": "← avg" }
      }
    }
  ],
  "config": { "view": { "stroke": null }, "axis": { "grid": false } }
}
