{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": "Policy Intensity Across Australian States",

  "width": 700,
  "height": 400,

  "data": {
    "url": "data/policy_intensity.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "ImpactLevel": "number"
      }
    }
  },

  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 3
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year"
    },

    "y": {
      "field": "ImpactLevel",
      "type": "quantitative",
      "title": "Policy Intensity",
      "scale": {
        "domain": [0, 5]
      }
    },

    "color": {
      "field": "State",
      "type": "nominal",
      "title": "State"
    },

    "tooltip": [
      {"field": "State"},
      {"field": "PolicyType"},
      {"field": "Year"},
      {"field": "ImpactLevel"}
    ]
  }
}