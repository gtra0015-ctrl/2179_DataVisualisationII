{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Policy Coverage Map — Fuel & Transport Events Across Australia",

  "width": 700,
  "height": 500,

  "projection": {
    "type": "mercator",
    "center": [133, -25],
    "scale": 900
  },

  "layer": [
    {
      "data": {
        "url": "data/states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#94a3b8",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/state_policy.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "ImpactLevel": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },

        "size": {
          "field": "ImpactLevel",
          "type": "quantitative",
          "scale": { "range": [80, 900] },
          "legend": { "title": "Impact Level" }
        },

        "color": {
          "field": "Event",
          "type": "nominal",
          "scale": { "scheme": "tableau20" },
          "legend": { "title": "Policy Event" }
        },

        "tooltip": [
          { "field": "Event", "type": "nominal" },
          { "field": "State", "type": "nominal" },
          { "field": "Type", "type": "nominal" },
          { "field": "ImpactLevel", "type": "quantitative" },
          { "field": "Date", "type": "temporal" }
        ]
      }
    },

    {
      "data": {
        "values": [
          { "State": "WA", "lon": 122, "lat": -25 },
          { "State": "NA", "lon": 133, "lat": -19 },
          { "State": "SA", "lon": 135, "lat": -30 },
          { "State": "QLD", "lon": 145, "lat": -21 },
          { "State": "NSW", "lon": 147, "lat": -33 },
          { "State": "VIC", "lon": 144.9, "lat": -37.8 },
          { "State": "TAS", "lon": 147, "lat": -42 },
          { "State": "ACT", "lon": 149.1, "lat": -35.3 }
        ]
      },

      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#111827"
      },

      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "State" }
      }
    }
  ]
}