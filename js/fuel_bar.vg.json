{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": 600,
  "height": 300,

  "title": "Fuel Price by State",

  "data": {
    "url": "data/fuel_prices_state.csv"
  },

  "mark": "bar",

  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal"
    },

    "y": {
      "field": "Price",
      "type": "quantitative"
    },

    "color": {
      "field": "Price",
      "type": "quantitative",
      "scale": { "scheme": "reds" }
    },

    "tooltip": [
      { "field": "State" },
      { "field": "Price" }
    ]
  }
}