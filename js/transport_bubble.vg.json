{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Annual Passenger Volume by Transport Mode (2025)",
    "subtitle": "Metro Train carried 185M passengers — 37% of total patronage across all modes",
    "subtitleColor": "#8a8f9e",
    "subtitleFontSize": 12,
    "fontSize": 14,
    "anchor": "start",
    "color": "#0f1117"
  },
  "width": 680,
  "height": 400,
  "data": { "url": "data/transport_mode_totals.csv" },
  "layer": [
    {
      "mark": { "type": "circle", "opacity": 0.8 },
      "encoding": {
        "x": {
          "field": "Mode",
          "type": "nominal",
          "title": "Transport Mode",
          "sort": { "field": "Passengers", "order": "descending" },
          "axis": { "labelAngle": -20, "labelFontSize": 11, "titleFontSize": 12 }
        },
        "y": {
          "field": "Passengers",
          "type": "quantitative",
          "title": "Annual Passengers",
          "axis": { "format": "~s", "labelFontSize": 11, "titleFontSize": 12 }
        },
        "size": {
          "field": "Passengers",
          "type": "quantitative",
          "scale": { "range": [400, 9000] },
          "legend": null
        },
        "color": {
          "field": "Mode",
          "type": "nominal",
          "scale": { "scheme": "tableau10" },
          "legend": null
        },
        "tooltip": [
          { "field": "Mode", "title": "Mode" },
          { "field": "Passengers", "title": "Annual Passengers", "format": ",.0f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "dy": -28, "fontSize": 11, "fontWeight": "500" },
      "encoding": {
        "x": {
          "field": "Mode",
          "type": "nominal",
          "sort": { "field": "Passengers", "order": "descending" }
        },
        "y": { "field": "Passengers", "type": "quantitative" },
        "text": { "field": "Passengers", "format": "~s" },
        "color": { "value": "#3d4250" }
      }
    }
  ],
  "config": { "view": { "stroke": null }, "axis": { "gridColor": "#e8e5df" } }
}
